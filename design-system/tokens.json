{
  "$description": "Boiler Room design tokens, draft v0. Mirrors tokens.css: change both together.",
  "color": {
    "brand": {
      "deep": { "value": "#086288", "name": "Pipe", "use": "Headings, primary buttons, outlines" },
      "steel": { "value": "#4D8DBA", "name": "Steel", "use": "Mascot body, field outlines, large text only (3.5:1)" },
      "sky": { "value": "#97D7FF", "name": "Steam", "use": "Fills, hard shadows, highlights. Never text on light" },
      "cream": { "value": "#FFEFC4", "name": "Butter", "use": "Warm panels, claim highlights" }
    },
    "derived": {
      "ink": { "value": "#0B2E40", "use": "Body text, 13.7:1 on paper" },
      "muted": { "value": "#3D6A87", "use": "Secondary text, 5.6:1 on paper" },
      "paper": { "value": "#FFFBEF", "use": "Page background" },
      "white": { "value": "#FFFFFF", "use": "Cards, inputs" },
      "skySoft": { "value": "#DDF2FF", "use": "Cool panels, hover, selected rows" },
      "creamDeep": { "value": "#F4DB9A", "use": "Dashed rules, dot grid, dithering on butter" },
      "deepPress": { "value": "#064E6D", "use": "Primary button hover" }
    },
    "accent": {
      "pink": { "value": "#FF9EB5", "use": "Mascot blush" },
      "mint": { "value": "#9FE3C1", "use": "Done, sparingly" }
    },
    "status": {
      "success": { "soft": "#DDF7E9", "ink": "#17654A" },
      "warning": { "soft": "#FFEFC4", "ink": "#7A5300" },
      "error": { "soft": "#FFE1DE", "ink": "#A82A20" },
      "attention": { "soft": "#FFE1EA", "ink": "#A3214C", "use": "Needs you: a person has to act" },
      "info": { "soft": "#DDF2FF", "ink": "#086288" }
    }
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "weights": [700, 800], "use": "Headings, buttons, tabs" },
    "body": { "family": "Nunito", "weights": [400, 600, 700, 800], "use": "Reading and UI text" },
    "label": { "family": "JetBrains Mono", "weights": [600], "use": "Labels, badges, table heads. 11px, upper case, 0.06em" },
    "mono": { "family": "JetBrains Mono", "weights": [400, 600], "use": "Data, code, timecodes" },
    "pixel": { "family": "Pixelify Sans", "weights": [700], "use": "Scoreboard numbers only, 24px and up" },
    "ligatures": "none"
  },
  "text": {
    "display": { "size": 64, "line": 1.0 },
    "h1": { "size": 44, "line": 1.05 },
    "h2": { "size": 32, "line": 1.1 },
    "h3": { "size": 24, "line": 1.15 },
    "h4": { "size": 19, "line": 1.2 },
    "lg": { "size": 18, "line": 1.6 },
    "md": { "size": 16, "line": 1.6 },
    "sm": { "size": 14, "line": 1.5 },
    "label": { "size": 11, "line": 1.4 },
    "mono": { "size": 13, "line": 1.5 },
    "score": { "minSize": 24, "line": 1.0 }
  },
  "pixel": {
    "size": 3,
    "sizes": { "small": 2, "default": 3, "hero": 4 },
    "shadowLift": "2 pixels",
    "radius": 0
  },
  "space": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "layout": { "maxWidth": 1160, "gutter": 24, "gutterMobile": 16 },
  "motion": {
    "frameMs": 83,
    "fps": 12,
    "easing": "steps() only",
    "press": "1 frame",
    "hover": "1 frame",
    "blink": "2 frames every 4s",
    "steam": "9 steps over 18 frames"
  },
  "logo": {
    "grid": "24 x 24",
    "renderAt": [24, 48, 72, 96],
    "files": {
      "mark": "logo/boiler-mark.svg",
      "markOnDeep": "logo/boiler-mark-on-deep.svg",
      "lockup": "logo/lockup.svg",
      "lockupOnDeep": "logo/lockup-on-deep.svg",
      "wordmark": "logo/wordmark.svg",
      "wordmarkStacked": "logo/wordmark-stacked.svg"
    }
  }
}
